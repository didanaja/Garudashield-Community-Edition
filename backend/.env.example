# GarudaShield Demo Edition — backend configuration
# Copy to .env and adjust. Never commit real secrets.

GARUDA_LISTEN_ADDR=127.0.0.1:8080
GARUDA_APP_ENV=development
GARUDA_LOG_LEVEL=info

# Single, explicitly configured upstream. Clients cannot choose a destination.
GARUDA_UPSTREAM_URL=http://127.0.0.1:8099
GARUDA_ALLOW_PRIVATE_UPSTREAM=true
GARUDA_UPSTREAM_TIMEOUT=10s
GARUDA_RESPONSE_HEADER_TIMEOUT=10s

# Request size limits
GARUDA_MAX_BODY_BYTES=1048576
GARUDA_MAX_URL_BYTES=2048
GARUDA_MAX_HEADER_BYTES=32768

# Evaluation budget (fail-closed)
GARUDA_EVALUATION_BUDGET=50ms
GARUDA_FAIL_CLOSED=true

# Rate limiting (single-process, per-instance)
GARUDA_RATE_LIMIT_ENABLED=true
GARUDA_RATE_LIMIT_BURST=60
GARUDA_RATE_LIMIT_WINDOW=10s
GARUDA_RATE_LIMIT_MAX_KEYS=10000

# Trusted proxies for X-Forwarded-For (comma-separated CIDRs or IPs)
GARUDA_TRUST_FORWARDED=false
GARUDA_TRUSTED_PROXIES=

# CORS origins (comma-separated)
GARUDA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin control plane
GARUDA_ADMIN_USER=admin
# Option A: pre-computed PBKDF2 hash (recommended)
#   go run ./cmd/server -hash-password "your-strong-password"
# GARUDA_ADMIN_PASSWORD_HASH=pbkdf2_sha256$210000$...
# Option B: plaintext (development convenience only, hashed in-memory at startup)
GARUDA_ADMIN_PASSWORD=change-me-in-demo
GARUDA_SESSION_TTL=8h
GARUDA_SESSION_SECRET=change-this-to-a-long-random-string
GARUDA_LOGIN_MAX_ATTEMPTS=5
GARUDA_LOGIN_WINDOW=5m

# Storage backend: memory (default) or a future redis implementation
GARUDA_STORE=memory
