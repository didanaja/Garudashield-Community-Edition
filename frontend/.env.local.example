# Frontend configuration for the GarudaShield demo.
#
# By default the frontend proxies /api/* to the backend through Next.js
# rewrites, so requests are same-origin and session cookies work. You normally
# do NOT need to set NEXT_PUBLIC_API_BASE_URL.

# Optional: only set this if the API is served from a different origin.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# Where Next.js rewrites send API traffic (server-side, not exposed to browser).
API_PROXY_TARGET=http://127.0.0.1:8080

# The dashboard's Traffic Tester sends demo requests directly to the protection
# engine so the raw request target is preserved. The engine allows this origin
# via its restrictive CORS policy.
# NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:8080
